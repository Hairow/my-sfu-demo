{
    "name": "my-sfu-demo",
    "main": "src/index.js",
    "compatibility_date": "2026-08-01",
    // Workers Static Assets：托管 public 目录下的前端静态资源
    // 不显式配置 not_found_handling（默认 "none"）：
    // 静态 miss 时请求会落入 Worker fetch，由 index.js 中 ASSETS.fetch 确认 404 后
    // 继续处理 /room/ws 与 /realtime/*
    "assets": {
        "directory": "./public"
    },
    // 多人会议房间：每个房间一个 Durable Object 实例，WebSocket 广播成员加入/离开
    "durable_objects": {
        "bindings": [
            {
                "name": "ROOMS",
                "class_name": "Room"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": [
                "Room"
            ]
        }
    ],
    // 公开静态变量（App Id 是公开标识，可以放这里）
    // 注意：App Secret 绝不能放这里，请用 wrangler secret put REALTIME_APP_SECRET 配置
    // 配置一个api访问的密码，        请用 wrangler secret put REALTIME_ACCESS_TOKEN 配置
    "vars": {
        "REALTIME_APP_ID": "a29e48395cf0911f40bfc4f08cc9bd9e"
    },
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": false,
            "persist": true,
            "head_sampling_rate": 1
        }
    }
}